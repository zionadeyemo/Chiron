# Anthropic (sk-ant-…) or Google Gemini key. The provider is detected from the key.
# Server-side only; never exposed to the browser.
LLM_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini      # anthropic | gemini (only needed if detection guesses wrong)
# LLM_MODEL=               # default: claude-opus-5-5 / gemini-flash-latest
# LLM_EFFORT=              # low | medium | high — low is faster but explains more freely
# LLM_MOCK=1               # offline scripted tutor for UI development only — NOT the product
