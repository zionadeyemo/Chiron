# Anthropic (sk-ant-…) or Google Gemini key. The provider is detected from the key.
# Server-side only; never exposed to the browser.
LLM_API_KEY=

# Protects /internal/summary (validation metrics). Required in production; open in dev if unset.
INTERNAL_PASSWORD=

# Optional overrides
# LLM_PROVIDER=gemini        # anthropic | gemini (only needed if detection guesses wrong)
# LLM_PLANNER_MODEL=         # strong tier, builds solution plans. Default gemini-pro-latest / claude-opus-5-5
# LLM_CHAT_MODEL=            # fast tier: chat, intake, reading work. Default gemini-flash-latest / claude-opus-5-5
# LLM_MODEL=                 # sets both tiers at once
# LLM_EFFORT=                # low | medium | high — chat thinking
# LLM_PLANNER_EFFORT=medium  # low | medium | high — planner thinking (high is slower, more careful)
# LLM_DEBUG=1                # log per-call timings to the server console
# CHIRON_DATA_DIR=           # where local data lives (default ./data)
# LLM_MOCK=1                 # offline scripted tutor for UI development and tests only — NOT the product
